rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMember(cid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
    }

    // Each person's own small profile (which couple they belong to)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes: you can look one up if you know it, but nobody can list them
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /couples/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];

      // The second person can join only while exactly one seat is taken,
      // and can only add themselves to the member list.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members;

      // Status + location: both can read, only the owner can write their own card
      match /people/{uid} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && request.auth.uid == uid;
      }

      // Cycle: the partner can read only if the owner switched sharing on
      match /cycle/{uid} {
        allow read: if isMember(cid) && (request.auth.uid == uid || resource.data.share == true);
        allow write: if isMember(cid) && request.auth.uid == uid;
      }

      match /schedule/{id} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.owner == request.auth.uid;
        allow update, delete: if isMember(cid) && resource.data.owner == request.auth.uid;
      }

      match /events/{id} {
        allow read, write: if isMember(cid);
      }

      match /thoughts/{id} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.author == request.auth.uid;
        allow update, delete: if isMember(cid) && resource.data.author == request.auth.uid;
      }
    }
  }
}
